---
import Hero from "@/components/Hero.astro";
import PageCta from "@/components/PageCta.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { processSteps } from "@/data/services";
import { withBase } from "@/utils/paths";
---

<BaseLayout title="商品化の進め方" description="作りたい商品が決まっている場合も、探すところから始めたい場合も、状況に合わせて商品化を進めます。">
  <Hero
    eyebrow="Process"
    title="商品化の進め方"
    lead="作りたい商品が決まっている場合も、探すところから始めたい場合も、状況に合わせて商品化を進めます。"
  />

  <section class="section container-page">
    <div class="grid gap-5 md:grid-cols-2">
      <article class="rounded-md border border-line border-t-4 border-t-primary bg-white p-6 md:p-8">
        <p class="eyebrow">Start 01</p>
        <h2 class="heading-3 mb-3">作りたい商品がある</h2>
        <p class="text-sub">参考製品、仕様、販売先、希望時期などをもとに、商品化に必要な工程を整理します。</p>
      </article>
      <article class="rounded-md border border-line bg-white p-6 md:p-8">
        <p class="eyebrow">Start 02</p>
        <h2 class="heading-3 mb-3">こんな商品を探したい</h2>
        <p class="text-sub">海外で実績のある製品や新たに開発された製品を活用できる可能性から検討します。</p>
      </article>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-page">
      <div class="section-heading">
        <p class="eyebrow">Flow</p>
        <h2>相談から販売開始まで</h2>
        <p>商品化に必要な工程を、状況に合わせて一緒に整理します。</p>
      </div>
      <div class="grid gap-4">
        {processSteps.map(([title, text], index) => (
          <article class="grid gap-4 border-t border-line py-6 md:grid-cols-[120px_220px_1fr]">
            <span class="font-latin text-sm font-bold text-primary">STEP {index + 1}</span>
            <h3 class="text-[22px] font-semibold leading-[1.4]">{title}</h3>
            <p class="text-sub">{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section container-page">
    <div class="section-heading">
      <p class="eyebrow">Design Support</p>
      <h2>商品まわりのデザイン</h2>
      <p>商品を販売するために必要なデザインや制作まで対応しています。</p>
    </div>
    <div class="grid gap-5 md:grid-cols-3">
      {[
        ["商品に付帯するもの", ["パッケージ", "取扱説明書", "ラベル", "表示内容"]],
        ["売り場に関わるもの", ["Webサイト", "EC掲載画像", "チラシ", "店頭POP", "展示会ツール"]],
        ["ブランド設計", ["ロゴ", "ネーミング", "ブランドサイト", "ブランドガイドライン"]]
      ].map(([title, items]) => (
        <article class="rounded-md border border-line bg-white p-6">
          <h3 class="mb-4 text-[22px] font-semibold leading-[1.4]">{title}</h3>
          <ul class="space-y-2 text-sm text-sub">
            {(items as string[]).map((item) => <li>{item}</li>)}
          </ul>
        </article>
      ))}
    </div>
    <a href={withBase("/works/#keeppot")} class="text-link mt-7">ブランド設計の実績を見る <span aria-hidden="true">→</span></a>
  </section>

  <PageCta
    primaryLabel="商品化について相談する"
    primaryHref="/contact/business/"
    secondaryLabel="実績を見る"
    secondaryHref="/works/"
  />
</BaseLayout>
