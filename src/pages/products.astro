---
import Hero from "@/components/Hero.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ExternalLink from "@/components/ExternalLink.astro";
import { productCategories } from "@/data/products";
import { withBase } from "@/utils/paths";
---

<BaseLayout title="製品一覧" description="INBESが企画・販売する製品をご紹介しています。" siteMode="products">
  <Hero eyebrow="Products" title="製品一覧" image="/assets/page-visuals/products-generated-v1.png" imageClass="object-[58%_82%]" />

  <nav class="container-page pb-4 pt-2" aria-label="製品カテゴリ">
    <div class="grid border-b border-line sm:grid-cols-2 lg:grid-cols-3">
      {productCategories.map((category) => (
        <a class="flex items-center justify-between gap-4 border-b border-line px-3 py-4 text-sm font-semibold last:border-b-0 hover:text-primary sm:px-5 lg:[&:nth-last-child(-n+3)]:border-b-0" href={`#${category.id}`}>
          <span>{category.title}</span>
          <span aria-hidden="true">↓</span>
        </a>
      ))}
    </div>
  </nav>

  <section id="lineup" class="section container-page scroll-mt-24">
    <div class="grid gap-14 md:gap-20">
      {productCategories.map((category) => (
        <section id={category.id} class="scroll-mt-28">
          <div class="mb-7 border-t border-line pt-5">
            <p class="eyebrow">{category.eyebrow}</p>
            <h2 class="heading-3">{category.title}</h2>
          </div>
          <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            {category.products.map((product) => (
              <article class="group relative flex h-full flex-col rounded-md border border-line bg-white p-6 transition-[background-color,border-color,box-shadow,transform] duration-200 ease-out hover:border-primary/40 hover:bg-primary/[0.03] hover:shadow-[0_8px_24px_rgba(198,16,30,0.08)] focus-within:border-primary/40 focus-within:bg-primary/[0.03] focus-within:shadow-[0_8px_24px_rgba(198,16,30,0.08)] motion-safe:hover:-translate-y-0.5 motion-safe:focus-within:-translate-y-0.5">
                <div class="mb-5 aspect-video overflow-hidden rounded-md bg-soft">
                  <img
                    class="h-full w-full object-contain transition-transform duration-300 ease-out motion-safe:group-hover:scale-[1.015] motion-safe:group-focus-within:scale-[1.015]"
                    src={withBase(product.image)}
                    alt={product.imageAlt}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <p class="mb-2 font-latin text-xs font-bold text-primary">{product.tag}</p>
                {product.name ? (
                  <>
                    <h3
                      class:list={[
                        "text-[22px] font-semibold leading-[1.4]",
                        !product.models && "mb-4",
                        product.nameLang === "en" && "font-latin"
                      ]}
                      lang={product.nameLang}
                    >
                      {product.name}
                    </h3>
                    {product.models && (
                      <p class="mb-4 mt-1 font-product text-[18px] font-bold leading-[1.4] text-sub">
                        <span class="sr-only">型番：</span>
                        {product.models.join(" / ")}
                      </p>
                    )}
                  </>
                ) : (
                  <h3 class="mb-4 font-product text-[22px] font-bold leading-[1.4]" lang="en">
                    <span class="sr-only">{product.tag} 型番：</span>
                    {product.models?.join(" / ")}
                  </h3>
                )}
                <p class="mb-6 text-sm text-sub">{product.description}</p>
                <ExternalLink
                  class="mt-auto w-fit after:absolute after:inset-0 after:rounded-md after:content-[''] focus-visible:outline-none focus-visible:after:ring-2 focus-visible:after:ring-primary focus-visible:after:ring-offset-2"
                  href={product.url}
                  ariaLabel={`${product.name ?? product.models?.join(" / ") ?? product.tag}の製品ページを新しいタブで開く`}
                >
                  {product.linkLabel}
                </ExternalLink>
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>

  <section class="border-y border-line bg-soft">
    <div class="container-page grid gap-8 py-14 md:grid-cols-[1fr_auto] md:items-end md:py-16">
      <div class="max-w-3xl">
        <p class="eyebrow">Product Archive</p>
        <h2 class="heading-2">過去の製品をお探しの方へ</h2>
        <p class="mt-5 text-sub">生産を完了した製品の仕様や取扱説明書などをご案内しています。</p>
      </div>
      <a class="button button-outline-dark" href={withBase("/products/discontinued/")}>生産完了品一覧を見る</a>
    </div>
  </section>
</BaseLayout>
