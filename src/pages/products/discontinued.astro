---
import Hero from "@/components/Hero.astro";
import { discontinuedProductCategories } from "@/data/discontinued-products";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { withBase } from "@/utils/paths";

const discontinuedProducts = discontinuedProductCategories.flatMap((category) => category.products);
---

<BaseLayout
  title="生産完了品・生産終了品一覧"
  description="INBESが過去に販売した生産完了品の一覧です。製品の特定や仕様、取扱説明書などの確認にご利用ください。"
  siteMode="products"
>
  <Hero eyebrow="Discontinued Products" title="生産完了品" />

  <section class="border-b border-line bg-white">
    <div class="container-content py-12 md:py-16">
      <p class="text-sub">
        生産を完了した製品をご案内しています。掲載している製品情報は生産完了時点の内容です。製品の仕様や取扱説明書は、掲載のある旧製品ページからご確認ください。
      </p>
      <a class="text-link mt-6" href={withBase("/products/")}>現在販売中の製品を見る <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="section container-content pt-10 md:pt-14">
    <h2 class="sr-only">生産完了品一覧</h2>
    <ul class="border-y border-line">
      {discontinuedProducts.map((product) => (
        <li class="border-b border-line last:border-b-0">
          <a
            class="group flex items-center justify-between gap-6 px-3 py-5 transition-colors hover:bg-soft sm:px-5 md:py-6"
            href={product.url ?? withBase("/contact/support/")}
            target={product.url ? "_blank" : undefined}
            rel={product.url ? "noopener noreferrer" : undefined}
            aria-label={`${product.name ?? product.models?.join(" / ") ?? product.tag}${product.url ? "の旧製品ページを新しいタブで開く" : "のサポートを開く"}`}
          >
            <div class="min-w-0">
              <p class="flex flex-wrap items-baseline gap-x-3 gap-y-1 leading-[1.5]">
                <span class="text-xs font-semibold text-primary">生産完了</span>
                <span class="font-semibold">
                  {product.tag}{product.name && <>　<span class:list={product.nameLang === "en" && "font-latin"} lang={product.nameLang}>{product.name}</span></>}
                </span>
              </p>
              {product.models?.length && (
                <p class="mt-1 font-product text-[17px] font-bold leading-[1.4] text-ink md:text-[18px]">
                  <span class="sr-only">型番：</span>
                  {product.models.join(" / ")}
                </p>
              )}
            </div>
            <span class="shrink-0 text-xl text-primary transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
            {product.url && <span class="sr-only">（新しいタブで開きます）</span>}
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="border-y border-line bg-soft">
    <div class="container-page grid gap-8 py-16 md:grid-cols-[1fr_auto] md:items-end md:py-20">
      <div class="max-w-3xl">
        <p class="eyebrow">Product Support</p>
        <h2 class="heading-2">お使いの製品についてお困りですか？</h2>
        <p class="mt-5 text-sub">製品本体や取扱説明書に記載された型番をご確認のうえ、サポート窓口へお問い合わせください。</p>
      </div>
      <a class="button button-primary" href={withBase("/contact/support/")}>製品サポートへ</a>
    </div>
  </section>
</BaseLayout>
