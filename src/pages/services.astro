---
import BusinessContactCta from "@/components/BusinessContactCta.astro";
import DevelopmentCapabilitySlider from "@/components/DevelopmentCapabilitySlider.astro";
import Hero from "@/components/Hero.astro";
import Icon from "@/components/Icon.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { fields, processSteps } from "@/data/services";
import { withBase } from "@/utils/paths";

const developmentCapabilities = [
  {
    title: "法令適合・認証対応",
    text: "PSEや電波法など、日本国内で販売するために必要な法令や規格を確認し、試験・届出・認証取得などの対応を進めます。",
    image: "/assets/services/development/01-legal-compliance-v3.jpg",
    imageAlt: "布団・衣類乾燥機を囲み、資料と電源仕様を確認する商品化支援の打ち合わせ"
  },
  {
    title: "品質確認・管理",
    text: "必要に応じて安全性や品質を国内基準や販売先の条件に照らして確認し、必要な改善と品質管理を行います。",
    image: "/assets/services/development/02-quality-management-v3.jpg",
    imageAlt: "布団・衣類乾燥機の温度や風量、動作音を測定する品質確認の工程"
  },
  {
    title: "仕様・機能のカスタマイズ",
    text: "仕様変更や機能追加など、日本市場や販売先に適した調整を行います。",
    image: "/assets/services/development/03-customization-v3.jpg",
    imageAlt: "布団・衣類乾燥機のノズルや操作パネル、内部機構を手に取り仕様を検討する開発工程"
  },
  {
    title: "デザインアレンジ",
    text: "国内のトレンドやユーザーの嗜好、売場の要望に合わせ、意匠・カラー・素材などを調整します。",
    image: "/assets/services/development/04-design-arrangement-v3.jpg",
    imageAlt: "布団・衣類乾燥機の本体色と素材サンプルを囲んで検討するデザイン打ち合わせ"
  },
  {
    title: "パッケージ・説明書・付属品",
    text: "国内向けのパッケージ、取扱説明書、付属品など、販売に必要な一式を整えます。",
    image: "/assets/services/development/05-packaging-accessories-v3.jpg",
    imageAlt: "布団・衣類乾燥機の付属品、取扱説明書、梱包材、パッケージを整える販売準備"
  },
  {
    title: "ブランド開発",
    text: "国内のデザイン会社と提携し、商品単体からシリーズ全体まで、世界観を構築した市場展開にも対応します。",
    image: "/assets/services/development/06-brand-development-v4.jpg",
    imageAlt: "架空ブランドNESTRAのロゴを製品シリーズとパッケージへ展開するブランド開発会議"
  }
];

---

<BaseLayout title="商品化支援" description="日本で販売するための商品化を、仕様整理から販売準備まで支援します。" siteMode="business">
  <Hero eyebrow="Product Development Support" title="商品化支援" image="/assets/page-visuals/commercialization-v3.png" imageClass="object-[62%_56%]" />

  <section class="section container-page">
    <div class="section-heading max-w-5xl">
      <p class="eyebrow">Issue</p>
      <h2>日本で売るための、商品づくりを共に。</h2>
      <p>商品開発が初めての場合、構想を具体化したい場合、開発全体を任せたい場合など、貴社の課題や体制に合わせた商品化支援を行います。海外製品のローカライズから、仕様整理、量産、輸入、販売準備まで、日本で販売できる状態へ整えます。</p>
    </div>
    <div class="grid gap-5 md:grid-cols-3">
      {[
        {
          number: "01",
          title: "エレクトロニクス商品を扱いたい",
          text: "異業種からの参入や、これまで雑貨などを扱ってきた企業に向けて、エレクトロニクス製品特有の仕様・認証・生産の進め方を整理し、商品化まで伴走します。",
          image: "/assets/services/issues/enter-electronics-line-v2.png",
          imageAlt: "製品仕様を検討する担当者のイラスト"
        },
        {
          number: "02",
          title: "商品化を前に進めたい",
          text: "営業・企画段階のアイデアはあるものの、製造ノウハウを持たない企業に向けて、仕様設計、技術検討、工場選定、認証、輸入手配までを支援します。",
          image: "/assets/services/issues/find-factory-line-v2.png",
          imageAlt: "製造先の選定に迷う担当者のイラスト"
        },
        {
          number: "03",
          title: "商品化をまとめて任せたい",
          text: "既存の販売ルートを活かした新商品展開に向けて、企画・開発から生産、輸入、入荷、販促準備までを一括して進めます。",
          image: "/assets/services/issues/private-brand-line-v1.png",
          imageAlt: "企画から生産・物流までを一括して進めるイラスト"
        }
      ].map((item) => (
        <article class="flex h-full flex-col overflow-hidden rounded-md border border-line bg-white">
          <img
            class="aspect-[3/2] w-full border-b border-line object-cover"
            src={withBase(item.image)}
            alt={item.imageAlt}
            width="1536"
            height="1024"
            loading="lazy"
            decoding="async"
          />
          <div class="flex flex-1 flex-col p-6">
            <span class="mb-5 block font-latin text-sm font-bold text-primary">NEED {item.number}</span>
            <h3 class="mb-3 text-[22px] font-semibold leading-[1.4]">{item.title}</h3>
            <p class="text-sm text-sub">{item.text}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section scroll-mt-24 overflow-x-clip bg-white" id="approach">
    <div class="container-page">
      <div class="grid gap-12 lg:grid-cols-[0.65fr_1.35fr] lg:items-start lg:gap-16">
        <div>
          <p class="eyebrow">Development Approach</p>
          <h2 class="heading-2 mb-6">商品開発のアプローチ</h2>
          <div class="space-y-5 text-sub">
            <p>ベースとなる既存製品を起点に、国内市場に合う仕様へ手を加えるローカライズ開発からご提案致します。</p>
            <p>法令や品質を確かめ、機能や意匠を調整し、パッケージやブランドまで一つずつ整えることで、開発期間とリスクを抑えながら、販売できる商品へ仕上げます。</p>
            <p>求める製品が見つからない場合や、より高い独自性が必要な場合は、足りない部分を新たに開発し、オリジナル商品として形にすることも可能です。</p>
          </div>
        </div>

        <DevelopmentCapabilitySlider items={developmentCapabilities} />
      </div>
    </div>
  </section>

  <section class="section scroll-mt-24 bg-soft" id="flow">
    <div class="container-page">
      <div class="section-heading mb-0">
        <p class="eyebrow">Flow</p>
        <h2>商品化の進め方</h2>
        <p>必要な工程を、商品や貴社の体制に合わせて組み合わせながら進めます。</p>
      </div>

      <ol class="mt-10 space-y-10 md:mt-12" aria-label="商品化の6つのステップ">
        {processSteps.map(([title, text], index) => (
          <li class="flow-step relative grid grid-cols-[48px_minmax(0,1fr)] items-center gap-x-5 gap-y-3 rounded-md border border-line bg-white p-6 md:p-7 lg:grid-cols-[64px_260px_minmax(0,1fr)] lg:gap-6">
            <span class="flex size-12 flex-col items-center justify-center font-latin font-bold leading-none text-primary" aria-hidden="true">
              <span class="text-[10px]">STEP</span>
              <span class="mt-1 text-base">{String(index + 1).padStart(2, "0")}</span>
            </span>
            <h3 class="text-[21px] font-semibold leading-[1.4] md:text-[22px]">{title}</h3>
            <p class="col-span-2 text-sub lg:col-span-1">{text}</p>
          </li>
        ))}
      </ol>
      <p class="mt-6 text-sm text-sub">追加生産や改良、シリーズ展開など、販売開始後の継続支援にも対応します。</p>
    </div>
  </section>

  <section class="section container-page scroll-mt-24" id="fields">
    <div class="section-heading">
      <p class="eyebrow">Fields</p>
      <h2>主な取扱分野</h2>
      <p>バッテリー・電源関連をはじめ、生活家電やカー用品、スマートフォン・PC周辺機器など、エレクトロニクス製品を中心に商品化を支援しています。</p>
    </div>
    <div class="grid gap-5 md:grid-cols-3">
      {fields.map((field) => (
        <article class="overflow-hidden rounded-md border border-line bg-white">
          <img
            class="aspect-[3/2] w-full object-cover"
            src={withBase(field.image)}
            alt={field.imageAlt}
            width="1536"
            height="1024"
            loading="lazy"
            decoding="async"
          />
          <div class="p-6">
            <h3 class="mb-3 text-[22px] font-semibold leading-[1.4]">{field.title}</h3>
            <p class="text-sm text-sub">{field.description}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-page">
      <a
        class="group grid overflow-hidden rounded-md border border-line bg-white transition-colors duration-300 hover:border-primary hover:bg-primary-pale focus-visible:border-primary md:grid-cols-[0.9fr_1.1fr]"
        href={withBase("/works/")}
        aria-label="開発実績を見る"
      >
        <div class="flex flex-col justify-center p-7 md:p-10 lg:p-12">
          <div class="flex items-start justify-between gap-5">
            <div>
              <p class="eyebrow">Works</p>
              <h2 class="text-[28px] leading-[1.3] md:text-[32px]">開発実績</h2>
            </div>
            <span class="grid size-11 shrink-0 place-items-center rounded-full bg-primary text-white transition-colors group-hover:bg-primary-dark" aria-hidden="true">
              <Icon name="arrow-right" size={20} />
            </span>
          </div>
          <p class="mt-5 text-sub">生活家電や車載機器など、日本で販売するための商品化を支援してきた製品をご紹介します。</p>
        </div>
        <div class="aspect-[16/9] overflow-hidden border-t border-line bg-soft md:aspect-auto md:border-l md:border-t-0">
          <img
            class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.015]"
            src={withBase("/assets/page-visuals/works-v4.webp")}
            alt="INBESが商品化を支援した家電やエレクトロニクス製品"
            width="1670"
            height="942"
            loading="lazy"
            decoding="async"
          />
        </div>
      </a>
    </div>
  </section>

  <BusinessContactCta />
</BaseLayout>

<style>
  .flow-step:not(:last-child)::after {
    content: "";
    position: absolute;
    top: calc(100% + 14px);
    left: 50%;
    border-top: 12px solid #c8101e;
    border-right: 10px solid transparent;
    border-left: 10px solid transparent;
    transform: translateX(-50%);
  }
</style>
