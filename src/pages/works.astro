---
import Icon from "@/components/Icon.astro";
import Hero from "@/components/Hero.astro";
import BusinessContactCta from "@/components/BusinessContactCta.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { works, workSupportIcons } from "@/data/works";
import MediaFrame from "@/components/MediaFrame.astro";
---

<BaseLayout title="開発実績" description="商品化を支援した製品をご紹介します。" siteMode="business">
  <Hero eyebrow="Works" title="開発実績" image="/assets/page-visuals/works-v3.png" imageClass="object-[56%_52%]" />
  <section class="section container-page">
    <div class="mb-10 space-y-5 text-sub md:mb-12">
      <p>INBESでは、電源・バッテリー関連製品をはじめ、ドライブレコーダー、監視カメラ、カー用品、家電製品など、さまざまな電気製品の商品化に携わってきました。</p>
      <p class="text-base">OEM・ODMという事業の特性上、クライアント企業名は掲載していません。ここでは、当社が開発・商品化に携わった製品の一部をご紹介します。</p>
    </div>
    <div class="grid gap-6">
      {works.map((work) => (
        <article id={work.id} class="grid scroll-mt-28 gap-6 rounded-md border border-line bg-white p-5 lg:grid-cols-[minmax(280px,480px)_minmax(0,1fr)] md:p-7">
          <div class="work-visual self-start" style={`--work-image-scale: ${work.imageScale ?? 1}`}>
            <MediaFrame src={work.image ?? `/assets/works/${work.id}-v1.webp`} alt={`${work.title}の製品イメージ`} aspect="3/2" class="bg-white" />
          </div>
          <div class="flex min-w-0 flex-col justify-center">
            <p class="mb-3 text-sm font-bold text-primary">{work.category}</p>
            <div class="mb-4 flex flex-wrap items-center gap-3">
              <h2 class="heading-3">{work.title}</h2>
              {work.highlight && <span class="rounded border border-primary px-2 py-1 text-sm font-semibold text-primary">{work.highlight}</span>}
            </div>
            <p class="mb-6 text-sub">{work.description}</p>
            <div>
              <h3 class="mb-4 text-sm font-semibold">対応範囲</h3>
              <ul class="flex flex-wrap gap-x-5 gap-y-4" role="list">
                {work.supports.map((support) => (
                  <li class="flex w-16 flex-col items-center gap-2 text-center text-sm text-sub">
                    <Icon name={workSupportIcons[support]} size={32} class="text-ink" />
                    <span class="whitespace-nowrap">{support}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
  <BusinessContactCta />
</BaseLayout>

<style>
  .work-visual :global(.media-frame) {
    border: 0;
  }

  .work-visual :global(img) {
    transform: scale(var(--work-image-scale));
  }
</style>
