---
import ExternalLink from "@/components/ExternalLink.astro";
import Hero from "@/components/Hero.astro";
import PageCta from "@/components/PageCta.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { works } from "@/data/works";
---

<BaseLayout title="開発実績" description="商品化を支援した製品をご紹介します。">
  <Hero eyebrow="Works" title="開発実績" lead="商品化を支援した製品をご紹介します。" />
  <section class="section container-page">
    <div class="grid gap-6">
      {works.map((work) => (
        <article id={work.id} class="grid scroll-mt-28 gap-6 rounded-md border border-line bg-white p-5 md:grid-cols-[minmax(280px,420px)_1fr] md:p-7">
          <div class="placeholder aspect-[3/2]">{work.title}</div>
          <div>
            <h2 class="heading-3 mb-3">{work.title}</h2>
            <div class="mb-4 flex flex-wrap gap-2">
              <span class="tag-category">{work.category}</span>
            </div>
            <div class="mb-5 flex flex-wrap gap-2">
              {work.supports.map((support) => <span class="tag-support">{support}</span>)}
            </div>
            <p class="mb-5 text-sub">{work.description}</p>
            <p class="mb-4 text-sm font-semibold">クライアント：{work.client}</p>
            {work.url && (
              <ExternalLink href={work.url}>
                公式サイトを見る
              </ExternalLink>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>
  <PageCta
    primaryLabel="商品化について相談する"
    primaryHref="/contact/business/"
    secondaryLabel="商品化支援を見る"
    secondaryHref="/services/"
  />
</BaseLayout>
