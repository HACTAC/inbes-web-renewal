---
import { withBase } from "@/utils/paths";
type Props = { title: string };
const { title } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <meta name="color-scheme" content="only light" />
    <link rel="canonical" href={canonical} />
    <title>{title} | INBES Search Console NAS</title>
    <style is:inline>
      :root { color-scheme: only light; font-family: system-ui, sans-serif; color: #202830; background: #fff; }
      body { margin: 0; font-size: 1.0625rem; line-height: 1.8; overflow-wrap: anywhere; }
      .wrap { width: min(52rem, calc(100% - 2.5rem)); margin-inline: auto; }
      header { padding-block: 1.5rem; border-bottom: 1px solid #d8dfe5; }
      main { padding-block: 2rem 3rem; }
      footer { padding-block: 1.5rem; border-top: 1px solid #d8dfe5; }
      h1 { font-size: clamp(1.6rem, 5vw, 2.2rem); line-height: 1.45; }
      h2 { font-size: 1.3rem; margin-top: 2rem; }
      a { color: #0755a5; text-underline-offset: .2em; }
      a:focus-visible { box-shadow: 0 0 0 3px #0755a5; }
      li + li { margin-top: .5rem; }
      .label { margin: 0; font-size: .9rem; }
    </style>
  </head>
  <body>
    <header><div class="wrap"><a href={withBase("/site-analytics/")}>INBES Search Console NAS</a></div></header>
    <main class="wrap"><slot /></main>
    <footer><nav class="wrap" aria-label="関連情報">
      <a href={withBase("/site-analytics/privacy/")}>管理用連携のプライバシー説明</a> ·
      <a href={withBase("/contact/")}>お問い合わせ</a> ·
      <a href={withBase("/")}>株式会社INBESのサイト</a>
    </nav></footer>
  </body>
</html>
