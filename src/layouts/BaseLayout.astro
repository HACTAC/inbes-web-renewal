---
import Icon from "@/components/Icon.astro";
import { businessNavigation, modeSwitch, productNavigation } from "@/data/navigation";
import "../styles/global.css";
import { withBase } from "@/utils/paths";

type Props = {
  title?: string;
  description?: string;
  entrance?: boolean;
  siteMode?: "business" | "products";
};

const {
  title = "INBES株式会社",
  description = "INBESは、日本で売るための商品づくりを支える会社です。",
  entrance = false,
  siteMode = "business"
} = Astro.props;

const pageTitle = title === "INBES株式会社" ? title : `${title} | INBES株式会社`;
const headerNavigation = siteMode === "products" ? productNavigation : businessNavigation;
const localNavigation = headerNavigation.filter((item) => !item.emphasis);
const headerCta = headerNavigation.find((item) => item.emphasis);
const switchLink = siteMode === "products" ? modeSwitch.products : modeSwitch.business;
const modeLabel = siteMode === "products" ? "自社製品" : "商品化支援";
const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => {
  const resolved = withBase(href);
  return currentPath === resolved || (resolved !== "/" && currentPath.startsWith(resolved));
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FFFFFF" />
    <link rel="icon" href={withBase("/assets/brand/inbes-symbol-positive.svg")} type="image/svg+xml" />
    <title>{pageTitle}</title>
    <script is:inline>
      (function (d) {
        var config = { kitId: "kkr3cfh", scriptTimeout: 3000, async: true };
        var h = d.documentElement;
        var t = setTimeout(function () {
          h.className = h.className.replace(/\bwf-loading\b/g, "") + " wf-inactive";
        }, config.scriptTimeout);
        var tk = d.createElement("script");
        var f = false;
        var s = d.getElementsByTagName("script")[0];
        tk.src = "https://use.typekit.net/" + config.kitId + ".js";
        tk.async = true;
        tk.onload = tk.onreadystatechange = function () {
          var a = this.readyState;
          if (f || (a && a !== "complete" && a !== "loaded")) return;
          f = true;
          clearTimeout(t);
          try {
            Typekit.load(config);
          } catch (e) {}
        };
        s.parentNode.insertBefore(tk, s);
      })(document);
    </script>
  </head>
  <body>
    <a class="fixed left-4 top-4 z-[100] -translate-y-24 rounded bg-ink px-4 py-2 text-sm font-semibold text-white focus:translate-y-0" href="#main">
      本文へ移動
    </a>

    {
      !entrance && (
        <>
          <header class="sticky top-0 z-40 border-b border-line bg-white">
            <div class="container-page flex min-h-[72px] items-center gap-4">
              <div class="flex min-w-0 items-center gap-4">
                <a href={withBase("/")} aria-label="INBES トップ">
                  <img class="h-auto w-[120px] md:w-[136px]" src={withBase("/assets/brand/inbes-logo-horizontal.svg")} alt="INBES" />
                </a>
                <a class="hidden items-center gap-2 border-l border-line pl-4 text-xs font-semibold text-sub transition-colors hover:text-primary sm:inline-flex" href={withBase(switchLink.href)}>
                  {switchLink.label}
                  <Icon name="arrow-right" size={20} />
                </a>
              </div>

              <nav class="ml-auto hidden items-center gap-6 lg:flex" aria-label="グローバルナビゲーション">
                {localNavigation.map((item) => (
                  <a class="site-header-link" href={withBase(item.href)} aria-current={isCurrent(item.href) ? "page" : undefined}>
                    {item.label}
                  </a>
                ))}
                {headerCta && (
                  <a class="button button-primary min-h-11 px-5 text-sm" href={withBase(headerCta.href)} aria-current={isCurrent(headerCta.href) ? "page" : undefined}>
                    {headerCta.label}
                  </a>
                )}
              </nav>

              <div class="ml-auto flex items-center gap-3 lg:hidden">
                <span class="hidden text-xs font-semibold text-sub sm:inline">{modeLabel}</span>
                <button
                  class="grid size-11 place-items-center rounded border border-line bg-white transition-colors hover:border-ink"
                  type="button"
                  aria-label="メニューを開く"
                  aria-controls="mobile-navigation"
                  aria-expanded="false"
                  data-nav-open
                >
                  <Icon name="menu" size={24} />
                </button>
              </div>
            </div>
          </header>

          <div class="pointer-events-none fixed inset-0 z-50" id="mobile-navigation" aria-hidden="true" data-nav-root inert>
            <button class="absolute inset-0 bg-ink/45 opacity-0 transition-opacity" type="button" aria-label="メニューを閉じる" data-nav-close data-nav-backdrop />
            <aside
              class="absolute inset-y-0 right-0 flex w-[min(90vw,400px)] translate-x-full flex-col bg-white p-6 shadow-soft transition-transform duration-300"
              role="dialog"
              aria-modal="true"
              aria-label="モバイルナビゲーション"
              tabindex="-1"
              data-nav-panel
            >
              <div class="flex items-center justify-between border-b border-line pb-5">
                <img class="h-auto w-[120px]" src={withBase("/assets/brand/inbes-logo-horizontal.svg")} alt="INBES" />
                <button class="grid size-11 place-items-center rounded border border-line bg-white transition-colors hover:border-ink" type="button" aria-label="メニューを閉じる" data-nav-close>
                  <Icon name="xmark" size={24} />
                </button>
              </div>

              <a class="mt-6 flex items-center justify-between rounded border border-line border-l-4 border-l-primary bg-soft px-4 py-4 font-semibold transition-colors hover:bg-primary-pale" href={withBase(switchLink.href)}>
                {switchLink.label}
                <Icon name="arrow-right" size={20} />
              </a>

              <p class="eyebrow mb-2 mt-7">{modeLabel}</p>
              <nav class="grid border-t border-ink" aria-label={`${modeLabel}ナビゲーション`}>
                {localNavigation.map((item) => (
                  <a class="flex min-h-14 items-center border-b border-line font-semibold transition-colors hover:text-primary" href={withBase(item.href)} aria-current={isCurrent(item.href) ? "page" : undefined}>
                    {item.label}
                  </a>
                ))}
              </nav>

              {headerCta && (
                <a class="button button-primary mt-8 w-full" href={withBase(headerCta.href)}>
                  {headerCta.label}
                </a>
              )}
            </aside>
          </div>
        </>
      )
    }

    <main id="main">
      <slot />
    </main>

    {
      !entrance && (
        <footer class="border-t border-line bg-soft">
          <div class="container-page py-12 md:py-16">
            <div class="grid gap-10 border-b border-line pb-10 lg:grid-cols-[1.2fr_1fr]">
              <div>
                <a href={withBase("/")} aria-label="INBES トップ">
                  <img class="h-auto w-[136px]" src={withBase("/assets/brand/inbes-logo-horizontal.svg")} alt="INBES" />
                </a>
                <p class="mt-5 max-w-lg text-sm text-sub">株式会社INBES<br />〒206-0012 東京都多摩市貝取1510-1 永山JOYビル5F</p>
              </div>
              <div class="grid gap-8 sm:grid-cols-3">
                <nav class="grid content-start gap-2 text-sm text-sub" aria-label="商品化支援フッター">
                  <strong class="mb-2 text-ink">商品化支援</strong>
                  {businessNavigation.filter((item) => !item.emphasis).map((item) => <a class="hover:text-primary" href={withBase(item.href)}>{item.label}</a>)}
                </nav>
                <nav class="grid content-start gap-2 text-sm text-sub" aria-label="自社製品フッター">
                  <strong class="mb-2 text-ink">自社製品</strong>
                  {productNavigation.map((item) => <a class="hover:text-primary" href={withBase(item.href)}>{item.label}</a>)}
                </nav>
                <nav class="grid content-start gap-2 text-sm text-sub" aria-label="会社情報フッター">
                  <strong class="mb-2 text-ink">Company</strong>
                  <a class="hover:text-primary" href={withBase("/company/")}>会社概要</a>
                  <a class="hover:text-primary" href={withBase("/contact/")}>お問い合わせ</a>
                </nav>
              </div>
            </div>
            <div class="flex flex-col gap-4 pt-6 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
              <p>© INBES Co., Ltd.</p>
              <nav class="flex flex-wrap gap-x-5 gap-y-2" aria-label="法務情報">
                <a class="underline underline-offset-4 hover:text-ink" href={withBase("/privacy/")}>プライバシーポリシー</a>
                <a class="underline underline-offset-4 hover:text-ink" href={withBase("/cookies/")}>クッキーポリシー</a>
              </nav>
            </div>
          </div>
        </footer>
      )
    }

    <script>
      const navRoot = document.querySelector<HTMLElement>("[data-nav-root]");
      const navPanel = document.querySelector<HTMLElement>("[data-nav-panel]");
      const navBackdrop = document.querySelector<HTMLElement>("[data-nav-backdrop]");
      const navOpen = document.querySelector<HTMLButtonElement>("[data-nav-open]");
      const navClosers = document.querySelectorAll<HTMLElement>("[data-nav-close]");
      let lastFocused: HTMLElement | null = null;

      const navFocusable = () =>
        Array.from(navPanel?.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])') ?? []);

      const closeNavigation = () => {
        if (!navRoot || !navPanel || !navBackdrop || !navOpen) return;
        navRoot.classList.add("pointer-events-none");
        navPanel.classList.add("translate-x-full");
        navBackdrop.classList.add("opacity-0");
        navRoot.setAttribute("aria-hidden", "true");
        navRoot.inert = true;
        navOpen.setAttribute("aria-expanded", "false");
        document.body.style.overflow = "";
        lastFocused?.focus();
      };

      const openNavigation = () => {
        if (!navRoot || !navPanel || !navBackdrop || !navOpen) return;
        lastFocused = document.activeElement as HTMLElement;
        navRoot.classList.remove("pointer-events-none");
        navPanel.classList.remove("translate-x-full");
        navBackdrop.classList.remove("opacity-0");
        navRoot.setAttribute("aria-hidden", "false");
        navRoot.inert = false;
        navOpen.setAttribute("aria-expanded", "true");
        document.body.style.overflow = "hidden";
        navFocusable()[0]?.focus();
      };

      navOpen?.addEventListener("click", openNavigation);
      navClosers.forEach((closer) => closer.addEventListener("click", closeNavigation));
      navPanel?.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeNavigation));
      navPanel?.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          closeNavigation();
          return;
        }
        if (event.key !== "Tab") return;
        const focusable = navFocusable();
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (!first || !last) return;
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      });
    </script>
  </body>
</html>
