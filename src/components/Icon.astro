---
import { withBase } from "@/utils/paths";

type Props = {
  name: string;
  size?: 20 | 24 | 32 | 48;
  label?: string;
  class?: string;
};

const { name, size = 24, label, class: className } = Astro.props;
---

<svg
  class:list={["inline-block shrink-0", className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke-width="1.5"
  aria-hidden={label ? undefined : "true"}
  aria-label={label}
  role={label ? "img" : undefined}
>
  <use href={`${withBase("/assets/icons/iconoir.svg")}#${name}`}></use>
</svg>
