---
import { withBase } from "@/utils/paths";
---

<section class="pb-[72px] pt-8 md:pb-24 md:pt-10 lg:pb-[104px] lg:pt-12">
  <div class="container-content">
    <div class="grid gap-8 border border-line bg-soft p-7 sm:p-10 md:grid-cols-[minmax(0,1fr)_auto] md:items-center md:p-12">
      <div>
        <p class="eyebrow">Contact</p>
        <h2 class="heading-2 mb-5">商品化について相談する</h2>
        <p class="max-w-3xl text-sub">アイデア段階でも、探すところからでもご相談いただけます。貴社の状況に合わせて、商品化の進め方を整理します。</p>
      </div>
      <a class="button button-primary" href={withBase("/contact/business/")}>お問い合わせ</a>
    </div>
  </div>
</section>
