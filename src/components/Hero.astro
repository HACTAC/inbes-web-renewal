---
import { withBase } from "@/utils/paths";

type Props = {
  eyebrow: string;
  title: string;
  image?: string;
  imageClass?: string;
};

const { eyebrow, title, image, imageClass } = Astro.props;
---

<section class:list={["relative overflow-hidden border-b border-line", image ? "h-[260px] sm:h-[280px] md:h-[300px] lg:h-[320px]" : "bg-white"]}>
  {image && (
    <>
      <img
        class:list={["absolute inset-0 h-full w-full object-cover", imageClass ?? "object-center"]}
        src={withBase(image)}
        alt=""
        width="1672"
        height="941"
        fetchpriority="high"
      />
      <div class="page-hero-scrim absolute inset-0" aria-hidden="true"></div>
    </>
  )}
  <div class:list={[image ? "container-wide relative z-10 grid h-full content-center" : "container-page py-14 md:py-16"]}>
    <h1 class="heading-1 max-w-5xl">{title}</h1>
    <p class="mt-3 font-latin text-base font-bold text-primary md:text-lg">{eyebrow}</p>
  </div>
</section>
