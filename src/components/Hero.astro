---
type Props = {
  eyebrow: string;
  title: string;
  lead?: string;
};

const { eyebrow, title, lead } = Astro.props;
---

<section class="border-b border-line">
  <div class="container-page py-[72px] md:py-24 lg:py-[112px]">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="heading-1 max-w-5xl">{title}</h1>
    {lead && <p class="mt-7 max-w-3xl text-sub">{lead}</p>}
  </div>
</section>
