---
import { withBase } from "@/utils/paths";

type Props = {
  action?: string;
  categoryValue: string;
  detailLabel: string;
  detailPlaceholder: string;
  submitLabel: string;
  showCompany?: boolean;
};

const {
  action = "/contact/send.php",
  categoryValue,
  detailLabel,
  detailPlaceholder,
  submitLabel,
  showCompany = false
} = Astro.props;

const deploymentEnvironment = import.meta.env.PUBLIC_DEPLOY_ENV ?? "production";
const isFormEnabled = deploymentEnvironment === "production";
---

<form
  class="grid gap-6 rounded-md border border-line bg-white p-6 md:p-8"
  method="post"
  action={isFormEnabled ? withBase(action) : undefined}
  enctype="multipart/form-data"
  data-contact-form
  data-form-enabled={String(isFormEnabled)}
  data-max-file-size="10485760"
>
  <input type="hidden" name="category" value={categoryValue} />
  <input type="hidden" name="token" value="" />
  <label class="hidden" aria-hidden="true">
    Website
    <input name="website" autocomplete="off" tabindex="-1" />
  </label>
  <div class="grid gap-5 md:grid-cols-2">
    {showCompany && (
      <label class="grid gap-2 text-sm font-semibold">
        会社名 任意
        <input class="form-field font-light" name="company" autocomplete="organization" />
      </label>
    )}
    <label class="grid gap-2 text-sm font-semibold">
      お名前
      <input class="form-field font-light" name="name" autocomplete="name" required />
    </label>
    <label class="grid gap-2 text-sm font-semibold">
      メールアドレス
      <input class="form-field font-light" type="email" name="email" autocomplete="email" required />
    </label>
    <label class="grid gap-2 text-sm font-semibold">
      電話番号 任意
      <input class="form-field font-light" name="tel" autocomplete="tel" inputmode="tel" />
    </label>
  </div>
  <label class="grid gap-2 text-sm font-semibold">
    {detailLabel}
    <textarea class="form-field min-h-40 font-light" name="message" placeholder={detailPlaceholder} required></textarea>
  </label>
  <label class="grid gap-2 text-sm font-semibold">
    <span>資料添付 <small class="ml-1 font-light text-muted">任意</small></span>
    <input class="form-file font-light" type="file" name="attachment" accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png" />
    <span class="font-light text-muted">参考資料、仕様書、製品写真など。1ファイル10MBまで。</span>
  </label>
  <label class="flex items-start gap-3 text-sm text-sub">
    <input type="checkbox" name="privacy" required />
    <span>
      <a class="font-semibold text-primary underline underline-offset-4" href={withBase("/privacy/")} target="_blank" rel="noopener noreferrer">
        個人情報の取り扱い<span class="sr-only">（新しいタブで開きます）</span>
      </a>に同意します。
    </span>
  </label>
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
    <button class="button button-primary w-full sm:w-fit" type="submit" disabled aria-disabled="true">
      {isFormEnabled ? submitLabel : "ステージング環境では送信できません"}
    </button>
    <p class="text-xs text-muted">
      {isFormEnabled ? "送信後、この画面に受付結果を表示します。" : "フォームの表示確認専用です。実メール送信は行われません。"}
    </p>
  </div>

  <div class="form-status" data-state="sending" role="status" aria-live="polite" hidden>
    <strong>送信中です</strong>
    <span class="ml-2">画面を閉じずにお待ちください。</span>
  </div>
  <div class="form-status" data-state="success" role="status" aria-live="polite" hidden>
    <strong>ご相談を受け付けました</strong>
    <span class="ml-2">内容を確認のうえ、ご連絡いたします。</span>
  </div>
  <div class="form-status" data-state="error" role="alert" hidden>
    <strong>送信できませんでした</strong>
    <span class="ml-2">入力内容と通信環境をご確認ください。</span>
  </div>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>("[data-contact-form]").forEach((form) => {
    if (form.dataset.formEnabled !== "true") {
      form.addEventListener("submit", (event) => event.preventDefault());
      return;
    }

    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const file = form.querySelector<HTMLInputElement>('input[type="file"]');
    const error = form.querySelector<HTMLElement>('[data-state="error"]');
    const success = form.querySelector<HTMLElement>('[data-state="success"]');
    const sending = form.querySelector<HTMLElement>('[data-state="sending"]');
    const token = form.querySelector<HTMLInputElement>('[name="token"]');
    const maxFileSize = Number(form.dataset.maxFileSize ?? 10485760);

    if (!submit || !error || !success || !sending || !token) return;

    const setEnabled = (enabled: boolean) => {
      submit.disabled = !enabled;
      submit.setAttribute("aria-disabled", String(!enabled));
    };
    const refreshToken = async () => {
      const response = await fetch(form.action, { credentials: "same-origin", cache: "no-store" });
      if (!response.ok) throw new Error("Form unavailable");
      const result = await response.json();
      if (result.ok !== true || typeof result.token !== "string" || !/^[a-f0-9]{64}$/.test(result.token)) {
        throw new Error("Invalid form token");
      }
      token.value = result.token;
      setEnabled(true);
    };
    const showError = (message: string) => {
      error.hidden = false;
      error.querySelector("span")?.replaceChildren(document.createTextNode(message));
    };
    void refreshToken().catch(() => {
      showError("現在フォームをご利用いただけません。時間をおいて再度お試しください。");
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (submit.disabled || !form.reportValidity()) return;
      error.hidden = true;
      const selectedFile = file?.files?.[0];
      if (selectedFile && selectedFile.size > maxFileSize) {
        showError("添付ファイルは10MB以内にしてください。");
        file?.focus();
        return;
      }

      setEnabled(false);
      form.setAttribute("aria-busy", "true");
      sending.hidden = false;
      try {
        const response = await fetch(form.action, { method: "POST", body: new FormData(form), credentials: "same-origin" });
        const result = await response.json();
        if (!response.ok || result.ok !== true) {
          if (result.uncertain === true) {
            showError("受付結果を確認できませんでした。重複送信を避けるため、再送前にお電話でご確認ください。");
            return;
          }
          showError(response.status === 429 ? "送信回数の上限に達しました。時間をおいてお試しください。" : "送信できませんでした。入力内容をご確認のうえ、再度お試しください。");
          await refreshToken();
          return;
        }
        success.hidden = false;
        success.querySelector("span")?.replaceChildren(document.createTextNode(
          result.replySent === true ? "受付完了メールをお送りしました。" : "内容を確認のうえ、ご連絡いたします。"
        ));
        form.reset();
      } catch {
        // A lost response does not prove the server rejected the inquiry.
        showError("受付結果を確認できませんでした。重複送信を避けるため、再送前にお電話でご確認ください。");
      } finally {
        sending.hidden = true;
        form.removeAttribute("aria-busy");
      }
    });
  });
</script>
