{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Human-readable aquatic agent name registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "agent_names"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "agent_names": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*$"
      }
    }
  }
}
